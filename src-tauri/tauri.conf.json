{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Toolkit",
  "version": "0.1.0",
  "identifier": "it.logicaltech.pdftoolkit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Toolkit",
        "width": 1280,
        "height": 860,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF",
        "description": "Documento PDF",
        "mimeType": "application/pdf",
        "contentTypes": [
          "com.adobe.pdf"
        ],
        "role": "Editor"
      },
      {
        "ext": [
          "p7m"
        ],
        "name": "P7M",
        "description": "Documento firmato P7M",
        "mimeType": "application/pkcs7-mime",
        "role": "Viewer"
      },
      {
        "ext": [
          "lptk"
        ],
        "name": "Documento PDF Toolkit",
        "description": "Documento PDF Toolkit",
        "mimeType": "application/x-pdf-toolkit-document",
        "role": "Editor"
      }
    ],
    "externalBin": [
      "binaries/gs"
    ],
    "copyright": "\u00a9 2026 Logical Tech \u2014 CC BY-NC-SA 4.0",
    "category": "Productivity",
    "shortDescription": "Firma, compila e sistema i PDF, tutto in locale"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5MkJEMzQyMUMyQTI5M0QKUldROUtTb2NRdE1yR1lOc0JidkVTNEl1MHZsWTREYXcwZ3JlUDNmMDNIU1NVTlpOODh3MDBkMWMK",
      "endpoints": [
        "https://github.com/logical-tech/pdf-toolkit/releases/latest/download/latest.json"
      ]
    }
  }
}